DATABASE_URL=sqlite:///./dispatch.db
# Set AUTH_SECRET to a stable random value of at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If omitted, a process-local secret is used and tokens expire on restart.
# AUTH_SECRET=
LOCATION_MODE=static
TOKEN_TTL_SECONDS=3600
DISPATCH_RADIUS_KM=5
OFFER_TTL_SECONDS=60
LOCATION_MAX_AGE_SECONDS=300
